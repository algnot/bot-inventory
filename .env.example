# จาก Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# ใช้ Secret key (sb_secret_... หรือ service_role JWT) จะข้าม RLS
# หรือ Publishable key (sb_publishable_... หรือ anon) ก็ได้ ถ้าได้รัน schema.sql / rls.sql แล้ว
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ทางเลือก: รหัสล็อกคลังจากเซิร์ฟเวอร์ (หรือตั้งจากปุ่มในแอป)
# INVENTORY_PIN=1234
